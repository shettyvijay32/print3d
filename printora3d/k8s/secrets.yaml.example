# DEMO ONLY: replace every value before using outside a disposable Killercoda lab.
apiVersion: v1
kind: Secret
metadata:
  name: printora-secrets
  namespace: printora3d
type: Opaque
stringData:
  POSTGRES_DB: printora
  POSTGRES_USER: printora
  POSTGRES_PASSWORD: change-this-db-password
  JWT_SECRET: change-this-to-a-long-random-secret-at-least-32-characters
  ADMIN_EMAIL: admin@printora.local
  ADMIN_PASSWORD: ChangeMe123!
  MINIO_ROOT_USER: printora_minio
  MINIO_ROOT_PASSWORD: change-this-minio-password
  MINIO_BUCKET: customer-uploads
